{
  "task_id": "01_multiline_http_parser",
  "name": "multiline_http_parser",
  "description": "Parse HTTP raw request headers into a dictionary, supporting multiline header continuation lines (lines starting with space/tab append to previous header value) and normalizing header keys to lowercase.",
  "interface": {
    "class": "HTTPHeaderParser"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "Parse standard single-line headers into key-value pairs.",
      "category": "functional",
      "priority": "critical",
      "properties": [
        "key_value_extraction"
      ],
      "examples": [
        "Host: example.com -> {'host': 'example.com'}"
      ],
      "edge_cases": [
        "extra whitespace around colon"
      ],
      "verification_methods": [
        "unit_test"
      ]
    },
    {
      "id": "REQ-002",
      "description": "Support multiline header continuation where lines starting with SP or HTAB append to previous header value with space.",
      "category": "boundary",
      "priority": "critical",
      "properties": [
        "multiline_continuation"
      ],
      "examples": [
        "User-Agent: Mozilla/5.0\\n  (Windows NT 10.0) -> {'user-agent': 'Mozilla/5.0 (Windows NT 10.0)'}"
      ],
      "edge_cases": [
        "multiple continuation lines",
        "tab indentation"
      ],
      "verification_methods": [
        "behavioral_probe"
      ]
    },
    {
      "id": "REQ-003",
      "description": "Header keys must be normalized to lowercase.",
      "category": "functional",
      "priority": "important",
      "properties": [
        "key_lowercase_normalization"
      ],
      "examples": [
        "Content-Type -> content-type"
      ],
      "edge_cases": [
        "mixed case keys"
      ],
      "verification_methods": [
        "unit_test"
      ]
    }
  ]
}