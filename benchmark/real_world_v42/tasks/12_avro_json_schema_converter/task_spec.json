{
  "task_id": "12_avro_json_schema_converter",
  "name": "avro_json_schema_converter",
  "description": "Convert JSON payload to target Avro schema structure, enforcing type conversions and field defaults.",
  "interface": {
    "class": "AvroSchemaConverter"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "Convert types according to schema (e.g. string to int/float).",
      "category": "functional",
      "priority": "critical",
      "properties": [
        "type_coercion"
      ],
      "examples": [
        "'123' -> 123"
      ],
      "edge_cases": [
        "invalid coercion raises ValueError"
      ],
      "verification_methods": [
        "unit_test"
      ]
    },
    {
      "id": "REQ-002",
      "description": "Apply default field values when missing from payload.",
      "category": "functional",
      "priority": "important",
      "properties": [
        "default_field_filling"
      ],
      "examples": [
        "missing 'active' -> default True"
      ],
      "edge_cases": [
        "explicit None overriding default"
      ],
      "verification_methods": [
        "unit_test"
      ]
    }
  ]
}