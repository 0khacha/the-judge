{
  "task_id": "08_payload_schema_validator",
  "name": "payload_schema_validator",
  "description": "JSON payload validator checking required fields, types, and numeric range bounds.",
  "interface": {
    "class": "PayloadValidator"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "Validate presence of required schema fields.",
      "category": "functional",
      "priority": "critical",
      "properties": [
        "required_field_check"
      ],
      "examples": [
        "missing 'age' -> returns (False, ['missing age'])"
      ],
      "edge_cases": [
        "null field value when required"
      ],
      "verification_methods": [
        "unit_test"
      ]
    },
    {
      "id": "REQ-002",
      "description": "Validate data types against schema specification.",
      "category": "functional",
      "priority": "important",
      "properties": [
        "type_check"
      ],
      "examples": [
        "age='twenty' when type is int -> returns False"
      ],
      "edge_cases": [
        "boolean passed as integer"
      ],
      "verification_methods": [
        "unit_test"
      ]
    },
    {
      "id": "REQ-003",
      "description": "Enforce numeric range bounds (min/max).",
      "category": "boundary",
      "priority": "critical",
      "properties": [
        "numeric_range_bounds"
      ],
      "examples": [
        "min=0, max=120, val=-1 -> returns False"
      ],
      "edge_cases": [
        "value equal to boundary min/max"
      ],
      "verification_methods": [
        "behavioral_probe"
      ]
    }
  ]
}