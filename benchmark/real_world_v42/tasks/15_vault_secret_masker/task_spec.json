{
  "task_id": "15_vault_secret_masker",
  "name": "vault_secret_masker",
  "description": "Log masker redacting API keys, bearer tokens, credit card numbers, and passwords from log strings.",
  "interface": {
    "class": "SecretMasker"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "Mask standard API key patterns (e.g. sk_live_xxx -> sk_live_***).",
      "category": "security",
      "priority": "critical",
      "properties": [
        "mask_api_keys"
      ],
      "examples": [
        "sk_live_123456 -> [REDACTED]"
      ],
      "edge_cases": [
        "multiple keys in one string"
      ],
      "verification_methods": [
        "unit_test"
      ]
    },
    {
      "id": "REQ-002",
      "description": "Mask credit card numbers (13-19 digits).",
      "category": "security",
      "priority": "critical",
      "properties": [
        "mask_credit_cards"
      ],
      "examples": [
        "4532-0123-4567-8901 -> [REDACTED_CC]"
      ],
      "edge_cases": [
        "formatted with dashes or spaces"
      ],
      "verification_methods": [
        "behavioral_probe"
      ]
    }
  ]
}