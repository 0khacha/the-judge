{
  "task_id": "06_jwt_rbac_auth",
  "name": "jwt_rbac_auth",
  "description": "JWT session manager enforcing role-based permissions (RBAC) and explicit token revocation list.",
  "interface": {
    "class": "JWTRBACManager"
  },
  "requirements": [
    {
      "id": "REQ-001",
      "description": "Issue JWT token containing user roles.",
      "category": "functional",
      "priority": "critical",
      "properties": [
        "issue_token_rbac"
      ],
      "examples": [
        "issue('u1', ['admin']) -> valid token"
      ],
      "edge_cases": [
        "empty roles"
      ],
      "verification_methods": [
        "unit_test"
      ]
    },
    {
      "id": "REQ-002",
      "description": "Verify token role authorization for restricted actions.",
      "category": "security",
      "priority": "critical",
      "properties": [
        "authorize_role_check"
      ],
      "examples": [
        "user with ['read'] cannot perform 'admin' action"
      ],
      "edge_cases": [
        "multiple required roles"
      ],
      "verification_methods": [
        "behavioral_probe"
      ]
    },
    {
      "id": "REQ-003",
      "description": "Revoked tokens must immediately fail validation regardless of expiration.",
      "category": "security",
      "priority": "critical",
      "properties": [
        "token_revocation"
      ],
      "examples": [
        "revoke(t) -> validate(t) is False"
      ],
      "edge_cases": [
        "revoking twice"
      ],
      "verification_methods": [
        "behavioral_probe"
      ]
    }
  ]
}