# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.py text
*.md text
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text
*.sh text

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary

# Archived evaluation evidence: store byte-for-byte, so the recorded SHA-256 manifests
# (benchmark_frozen_sha256.txt, PROTOCOL*.sha256) still match a fresh clone.
eval_results/** -text
